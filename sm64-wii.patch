diff --git a/src/game/mario.c b/src/game/mario.c
index 634d3ec..6e70aac 100644
--- a/src/game/mario.c
+++ b/src/game/mario.c
@@ -1,3 +1,4 @@
+#include <math.h>
 #include <PR/ultratypes.h>
 
 #include "sm64.h"
@@ -1696,7 +1697,151 @@ void func_sh_8025574C(void) {
 /**
  * Main function for executing Mario's behavior.
  */
+#ifdef TARGET_WII
+void wii_player2_spawn(void);
+void initiate_painting_warp(void);
+extern struct DmaHandlerList gMarioAnimsBuf2;
+extern int gWiiPlayer2Active;
+#define WII_P2_MAX_DIST 5000.0f   /* si J2 se aleja mas, se teletransporta a J1 */
+#define WII_P2_MAX_DY 3500.0f
+
+static void wii_p2_teleport(void) {
+    struct MarioState *p1 = &gMarioStates[0];
+    struct MarioState *p2 = &gMarioStates[1];
+
+    vec3f_copy(p2->pos, p1->pos);
+    p2->pos[0] += 100.0f;
+    vec3f_set(p2->vel, 0.0f, 0.0f, 0.0f);
+    p2->forwardVel = 0.0f;
+    p2->faceAngle[1] = p1->faceAngle[1];
+    p2->health = 0x880;
+    p2->hurtCounter = 0;
+    p2->healCounter = 0;
+    p2->squishTimer = 0;
+    p2->invincTimer = 30;
+    p2->heldObj = NULL;
+    p2->riddenObj = NULL;
+    p2->usedObj = NULL;
+    p2->floorHeight = find_floor(p2->pos[0], p2->pos[1], p2->pos[2], &p2->floor);
+    if (p2->pos[1] < p2->floorHeight) {
+        p2->pos[1] = p2->floorHeight;
+    }
+    p2->marioObj->oPosX = p2->pos[0];
+    p2->marioObj->oPosY = p2->pos[1];
+    p2->marioObj->oPosZ = p2->pos[2];
+    vec3f_copy(p2->marioObj->header.gfx.pos, p2->pos);
+    set_mario_action(p2, ACT_FREEFALL, 0);
+}
+
+static void wii_p2_post_update(void) {
+    struct MarioState *p1 = &gMarioStates[0];
+    struct MarioState *p2 = &gMarioStates[1];
+    f32 dx = p2->pos[0] - p1->pos[0];
+    f32 dy = p2->pos[1] - p1->pos[1];
+    f32 dz = p2->pos[2] - p1->pos[2];
+    f32 dist = sqrtf(dx * dx + dz * dz);
+
+    if (p2->health < 0x100) {
+        wii_p2_teleport();   /* J2 nunca dispara la muerte del nivel */
+        return;
+    }
+    if (p2->action & ACT_FLAG_INTANGIBLE) {
+        return;              /* baile de estrella, puertas, tuneles: no interrumpir */
+    }
+    if (p2->floor == NULL || dist > WII_P2_MAX_DIST || dy > WII_P2_MAX_DY || dy < -WII_P2_MAX_DY) {
+        wii_p2_teleport();
+    }
+}
+
+void wii_player2_spawn(void) {
+    struct MarioState *p1 = &gMarioStates[0];
+    struct MarioState *m = &gMarioStates[1];
+    struct Object *o;
+
+    /* warp dentro de la misma area: el objeto de J2 sigue vivo, solo se recoloca junto a J1 */
+    if (m->marioObj != NULL && m->marioObj != gMarioObject
+        && m->marioObj->activeFlags != ACTIVE_FLAG_DEACTIVATED
+        && m->marioObj->behavior == segmented_to_virtual(bhvMario)) {
+        wii_p2_teleport();
+        return;
+    }
+
+    o = spawn_object(gMarioObject, MODEL_MARIO, bhvMario);
+    *m = *p1;
+    m->marioObj = o;
+    m->marioBodyState = &gBodyStates[1];
+    m->statusForCamera = &gPlayerCameraState[1];
+    m->controller = &gControllers[1];
+    m->animList = &gMarioAnimsBuf2;
+    m->pos[0] += 100.0f;
+    m->heldObj = NULL;
+    m->riddenObj = NULL;
+    m->usedObj = NULL;
+    m->floorHeight = find_floor(m->pos[0], m->pos[1], m->pos[2], &m->floor);
+    if (m->pos[1] < m->floorHeight) {
+        m->pos[1] = m->floorHeight;
+    }
+    o->header.gfx.animInfo.animID = -1;
+    o->oPosX = m->pos[0];
+    o->oPosY = m->pos[1];
+    o->oPosZ = m->pos[2];
+    o->oMoveAngleYaw = m->faceAngle[1];
+    vec3f_copy(o->header.gfx.pos, m->pos);
+    vec3s_set(o->header.gfx.angle, 0, m->faceAngle[1], 0);
+}
+
+static s32 execute_mario_action_inner(UNUSED struct Object *o);
+
+s32 execute_mario_action(struct Object *o) {
+    struct MarioState *p1 = &gMarioStates[0];
+    struct MarioState *p2 = &gMarioStates[1];
+    struct MarioState *savedState;
+    struct Object *savedObj;
+    s16 savedCamFlags;
+    s32 result;
+
+    if (o == gMarioObject || p2->marioObj != o) {
+        return execute_mario_action_inner(o);
+    }
+
+    /* Jugador 2: misma logica que J1 (estrellas, puertas, tuneles, pinturas) con su propio estado.
+       Estrellas, monedas, llaves y vidas se comparten con J1. La camara solo la controla J1. */
+    p2->numStars = p1->numStars;
+    p2->numKeys = p1->numKeys;
+    p2->numCoins = p1->numCoins;
+    p2->numLives = p1->numLives;
+
+    savedState = gMarioState;
+    savedObj = gMarioObject;
+    savedCamFlags = gCameraMovementFlags;
+
+    gMarioState = p2;
+    gMarioObject = o;
+    gWiiPlayer2Active = 1;
+
+    result = execute_mario_action_inner(o);
